# ─────────────────────────────────────────────────────────────
# Payflow 웹 환경변수 템플릿
#   개발:  cp .env.example .env.local   후 값 채우기
#   운영:  cp .env.example .env.prod    후 값 채우기
#   compose 운영 실행:  docker compose --env-file .env.prod up -d
# ─────────────────────────────────────────────────────────────

# ── 빌드타임 (NEXT_PUBLIC_*) ─────────────────────────────────
# next build 시 클라이언트 번들에 "문자열로 인라인"된다 → 반드시 빌드 시점에 설정.
# 브라우저에 노출되는 공개값이라 시크릿 아님 (CI에선 repo Variable 로 주면 됨).
# GHCR 등으로 미리 빌드한 이미지를 pull 해서 띄우는 경우엔 이미 박혀 있으므로 런타임에 불필요.

# 브라우저가 호출할 BE GraphQL 엔드포인트
#   개발: http://localhost:8080/graphql
#   운영: https://payflow.clauminirockpt.me/graphql   (nginx 같은 도메인 path 라우팅)
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8080/graphql

# 카카오맵 JavaScript 키 (Kakao Developers → 내 앱 → 앱 키 → JavaScript 키)
# 운영 도메인을 [플랫폼] → Web 에 등록해야 지도가 동작한다.
NEXT_PUBLIC_KAKAO_MAPS_APP_KEY=

# ── 런타임 (서버) ───────────────────────────────────────────
# 컨테이너 실행 시 주입. 이미지에 박히지 않음.

# Auth.js 세션 암호화 키 — 진짜 시크릿. 절대 커밋 금지.
#   생성: openssl rand -base64 33
AUTH_SECRET=

# 리버스 프록시(nginx) 뒤에서 동작하면 true
AUTH_TRUST_HOST=true
